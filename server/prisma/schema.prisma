// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Role {
  id        String   @id @default(uuid())
  nama      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  User      User[]
}

model User {
  id             String           @id @default(uuid())
  email          String           @unique
  password       String
  roleId         String
  role           Role             @relation(fields: [roleId], references: [id])
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  Absensi        Absensi[]
  LaporanSuvenir LaporanSuvenir[]
}

model Absensi {
  id           String    @id @default(uuid())
  fotoClockIn  String
  fotoClockOut String?
  clockIn      DateTime
  clockOut     DateTime?
  catatan      String
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  createdBy    String
  updatedBy    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model KabupatenKota {
  id        String      @id @default(uuid())
  nama      String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  Pasar     Pasar[]
  Responden Responden[]
}

model Pasar {
  id              String        @id @default(uuid())
  nama            String
  kabupatenKotaId String
  kabupatenKota   KabupatenKota @relation(fields: [kabupatenKotaId], references: [id])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  Responden       Responden[]
}

model Responden {
  id              String           @id @default(uuid())
  nama            String
  telp            String
  level           String
  kabupatenKotaId String
  pasarId         String
  kabupatenKota   KabupatenKota    @relation(fields: [kabupatenKotaId], references: [id])
  pasar           Pasar            @relation(fields: [pasarId], references: [id])
  createdBy       String
  updatedBy       String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  LaporanSuvenir  LaporanSuvenir[]
}

model LaporanSuvenir {
  id           String    @id @default(uuid())
  nama         String
  jenis        String
  periodeBulan String
  periodeTahun Int
  foto         String
  catatan      String
  respondenId  String
  userId       String
  responden    Responden @relation(fields: [respondenId], references: [id])
  user         User      @relation(fields: [userId], references: [id])
  createdBy    String
  updatedBy    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}
