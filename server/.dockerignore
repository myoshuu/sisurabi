**/npm-debug.log*
**/yarn-error.log*
**/pnpm-debug.log*
.pnpm-store

# Build outputs
build
dist
.out
.next

# VCS
.git
.gitignore

# Env and OS/editor junk
.env
.env.*
.DS_Store
.vscode
.idea

# Prisma generated client (will be generated in-image)
src/generated
